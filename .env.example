# Copy to .env.local for local development. Never commit real keys.

# Anthropic API key, server side only. Leave empty to run in demo mode, which replays recorded streams from evals/transcripts.
ANTHROPIC_API_KEY=

# Optional. Model used when the client does not choose one: claude-sonnet-5-5 (default) or claude-opus-5-5 (more thorough).
CHAT_DEFAULT_MODEL=claude-sonnet-5-5

# Optional. Effort for chat requests: low, medium (default), high, xhigh or max.
CHAT_EFFORT=medium

# Optional limits. Output tokens are counted across every model round of one request.
MAX_OUTPUT_TOKENS=4096
MAX_ROUNDS=5
MAX_BODY_BYTES=200000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600

# Optional. Live evals (npm run eval:live) stop starting new cases once the estimated spend passes this, in US dollars.
EVAL_BUDGET_USD=0.50

# Optional. Demo mode replays recordings at this multiple of their recorded speed. 0 replays instantly.
DEMO_PACE=1
